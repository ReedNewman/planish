{
  "name": "planish",
  "version": "1.0.0",
  "description": "Branded PDF generator that converts markdown documentation to professionally styled PDFs",
  "type": "module",
  "bin": {
    "planish": "./src/index.mjs"
  },
  "scripts": {
    "generate": "node src/index.mjs generate",
    "generate:latex": "node src/index.mjs generate --latex"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
